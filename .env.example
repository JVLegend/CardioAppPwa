# Railway injeta DATABASE_URL ao vincular o serviço PostgreSQL.
DATABASE_URL=
BOOTSTRAP_ADMIN_EMAIL=controlapps@gmail.com
BOOTSTRAP_ADMIN_NAME=Administrador KardiaApp
# Usada apenas para criar a primeira credencial. Remova do Railway após o primeiro deploy.
BOOTSTRAP_ADMIN_PASSWORD=
VITE_API_BASE_URL=
ALLOWED_APP_ORIGINS=
COOKIE_SECURE=false

# Limites do protocolo clínico, validados pelo responsável médico.
SYSTOLIC_URGENT_THRESHOLD=180
DIASTOLIC_URGENT_THRESHOLD=110
SYSTOLIC_LOW_THRESHOLD=90
DIASTOLIC_LOW_THRESHOLD=60

# Google Gemini — usado por:
#  • Foto de receita → preenche medicamento (MedicationsView)
#  • Insight diário no painel do médico (ControllerDashboardView)
# Crie em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
